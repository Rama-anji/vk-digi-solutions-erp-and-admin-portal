      "kind": "column",
      "source": "quotations.date"
    },
    "valid_until": {
      "kind": "column",
      "source": "quotations.valid_until"
    },
    "status": {
      "kind": "column",
      "source": "quotations.status"
    },
    "items": {
      "kind": "join",
      "source": "commercial_items.quotation_id",
      "note": "Rows ordered by position; map QuotationLineItem."
    },
    "subtotal": {
      "kind": "calculated",
      "source": "commercial_items.amount",
      "note": "v_quotation_totals: SUM(amount)."
    },
    "discount_amount": {
      "kind": "column",
      "source": "quotations.discount_amount"
    },
    "gst_rate": {
      "kind": "column",
      "source": "quotations.gst_rate"
    },
    "gst_amount": {
      "kind": "calculated",
      "source": "quotations.gst_rate",
      "note": "v_quotation_totals: ROUND(MAX(subtotal-discount_amount,0)*gst_rate/100,2)."
    },
    "grand_total": {
      "kind": "calculated",
      "source": "quotations.discount_amount",
      "note": "v_quotation_totals: MAX(subtotal-discount_amount,0)+gst_amount."
    },
    "notes": {
      "kind": "column",
      "source": "quotations.notes"
    },
    "terms_conditions": {
      "kind": "column",
      "source": "quotations.terms_conditions"
    },
    "custom_fields": {
      "kind": "column",
      "source": "quotations.custom_fields"
    },
    "converted_invoice_id": {
      "kind": "join",
      "source": "invoices.id",
      "note": "Find invoices.quotation_id = quotations.id."
    },
    "converted_invoice_number": {
      "kind": "join",
      "source": "invoices.invoice_number",
      "note": "Same invoice relation; do not store a second conversion link."
    },
    "created_at": {
      "kind": "column",
      "source": "quotations.created_at"
    }
  },
