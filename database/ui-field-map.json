  "Invoice": {
    "amount_received": {
      "kind": "calculated",
      "source": "payments_received.amount_received",
      "note": "Non-void invoice receipts; preserves manual Paid balances when no receipt history exists."
    },
    "balance_due": {
      "kind": "calculated",
      "source": "payments_received.amount_received",
      "note": "Invoice grand total less non-void receipts, floored at zero."
    },
    "receipt_count": {
      "kind": "calculated",
      "source": "payments_received.invoice_id",
      "note": "All receipt records, including voids, distinguish tracked invoices from legacy manual status."
    },
    "discount_amount": {
      "kind": "column",
      "source": "invoices.discount_amount"
    },
    "id": {
      "kind": "column",
      "source": "invoices.id"
    },
    "invoice_number": {
      "kind": "column",
      "source": "invoices.invoice_number"
    },
    "client_id": {
      "kind": "column",
      "source": "invoices.client_id"
    },
    "client_name": {
      "kind": "join",
      "source": "clients.name",
      "note": "v_invoices."
    },
    "total_amount": {
      "kind": "calculated",
      "source": "commercial_items.amount",
      "note": "v_invoice_totals: MAX(SUM(amount)-discount_amount,0)."
    },
    "gst_tax": {
      "kind": "calculated",
      "source": "invoices.gst_rate",
      "note": "v_invoice_totals: ROUND(discounted total_amount*gst_rate/100,2)."
    },
    "grand_total": {
      "kind": "calculated",
      "source": "commercial_items.amount",
      "note": "v_invoice_totals: total_amount+gst_tax."
    },
    "payment_status": {
      "kind": "column",
      "source": "invoices.payment_status"
    },
    "due_date": {
      "kind": "column",
      "source": "invoices.due_date"
    },
    "created_at": {
      "kind": "column",
      "source": "invoices.created_at"
    },
    "quotation_ref": {
      "kind": "join",
      "source": "quotations.quotation_number",
      "note": "Resolve to invoices.quotation_id on write; reference must exist and belong to same client."
    },
    "notes": {
      "kind": "column",
      "source": "invoices.notes"
    },
